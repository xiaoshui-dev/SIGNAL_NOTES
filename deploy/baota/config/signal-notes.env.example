# Signal Notes production environment
# Copy this file to /www/server/signal-notes/signal-notes.env and replace every CHANGE_ME value.

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=signal_notes
DB_USERNAME=signal_notes
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_AT_LEAST_12_CHARS

APP_PUBLIC_URL=https://blog.example.com
CORS_ORIGINS=https://blog.example.com

UPLOAD_DIR=/www/wwwroot/signal-notes/uploads
BACKUP_DIR=/www/backup/signal-notes
